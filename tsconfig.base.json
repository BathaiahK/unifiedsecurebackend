{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@usp/schema": ["packages/schema/src/index.ts"],
      "@usp/config": ["packages/config/src/index.ts"],
      "@usp/vuln-db": ["packages/vuln-db/src/index.ts"],
      "@usp/remediation": ["packages/remediation/src/index.ts"]
    }
  }
}
