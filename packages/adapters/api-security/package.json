{
  "name": "@usp/adapter-api-security",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "API Security Scanner - OpenAPI spec validation & auto-discovery",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@usp/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.1.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  }
}
