# Copy apps/api/.env.example → apps/api/.env
# Copy apps/web/.env.example → apps/web/.env.local

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=mongodb://localhost:27017/uspservice

# ── API Server ────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# ── BlackDuck SCA ─────────────────────────────────────────────────────────────
BLACKDUCK_URL=https://your-instance.blackduck.com
BLACKDUCK_API_TOKEN=

# ── Sysdig Container Security ─────────────────────────────────────────────────
SYSDIG_URL=https://app.sysdigcloud.com
SYSDIG_API_TOKEN=

# ── 42Crunch API Security ─────────────────────────────────────────────────────
CRUNCH42_API_KEY=
CRUNCH42_URL=https://platform.42crunch.com

# ── Sonatype Nexus IQ ─────────────────────────────────────────────────────────
SONATYPE_URL=https://your-instance.sonatype.com
SONATYPE_USERNAME=
SONATYPE_PASSWORD=

# ── Remediation Enrichment ────────────────────────────────────────────────────
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
OSV_API_URL=https://api.osv.dev/v1
REMEDIATION_CONCURRENCY=5

# ── Web Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
