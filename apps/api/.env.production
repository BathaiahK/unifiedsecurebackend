# PRODUCTION ENVIRONMENT - Fastify API
# Keep this file secure, never commit to version control
# NOTE: Sensitive values should be set via environment variables in Cloud Run

# ── Database (MongoDB Atlas) ───────────────────────────────────────────────────
# Set via GitHub Secret: DATABASE_URL
DATABASE_URL=

# ── API Server ─────────────────────────────────────────────────────────────────
NODE_ENV=production
# Cloud Run sets PORT=8080 automatically, do not override
HOST=0.0.0.0
LOG_LEVEL=warn
# CORS_ORIGIN is set at deployment time to match the frontend service URL
CORS_ORIGIN=*

# ── NVD API (Vulnerability Database Enrichment) ────────────────────────────────
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# ── OSV API (Open Source Vulnerabilities) ──────────────────────────────────────
OSV_API_URL=https://api.osv.dev/v1
