prisma:query db.Finding.insertMany([{ _id: "972531de-bcd7-4e73-b2ad-947e2368aa78", tool: "sonatype", severity: "high", cvss: 7.5, cve: "CVE-2026-33750", cwe: "CWE-400", title: "CVE-2026-33750 in brace-expansion@1.1.12", asset: "Language detection", status: "open", fixVersion: "5.0.5", firstSeen: DateTime("2026-05-04 11:13:11.159 +00:00:00"), lastSeen: DateTime("2026-05-04 11:13:11.159 +00:00:00"), remediationSteps: [ "No golden version available — review brace-expansion@1.1.12 manually.", "Check upstream advisories and consider an alternative dependency.", "See advisory: https://guide.sonatype.com/vulnerability/CVE-2026-33750?component-type=npm&component-name=brace-expansion&utm_source=node&utm_medium=integration", "Upgrade to version 5.0.5 or later", "See advisory: https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/33xxx/CVE-2026-33750.json", "See advisory: https://github.com/juliangruber/brace-expansion/commit/311ac0d54994158c0a384e286a7d6cbb17ee8ed5", ], references: [ { label: "NVD", url: "https://nvd.nist.gov/vuln/detail/CVE-2026-33750", }, { label: "OSS Index", url: "https://guide.sonatype.com/vulnerability/CVE-2026-33750?component-type=npm&component-name=brace-expansion&utm_source=node&utm_medium=integration", }, { label: "External Advisory", url: "http://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-33750", }, { label: "Component page", url: "https://guide.sonatype.com/component/npm/brace-expansion/1.1.12?utm_source=node&utm_medium=integration", }, ], evidence: { coordinates: "pkg:npm/brace-expansion@1.1.12", ecosystem: "npm", detectionType: "dependency", licenseId: null, licenseRisk: "UNKNOWN", goldenVersion: null, isReachable: null, qualityRisk: null, supplyChainThreat: null, vulnerabilityId: "CVE-2026-33750", description: "The brace-expansion library generates arbitrary strings containing a common prefix and suffix. Prior to versions 5.0.5, 3.0.2, 2.0.3, and 1.1.13, a brace pattern with a zero step value (e.g., `{1..2..0}`) causes the sequence generation loop to run indefinitely, making the process hang for seconds and allocate heaps of memory. Versions 5.0.5, 3.0.2, 2.0.3, and 1.1.13 fix the issue. As a workaround, sanitize strings passed to `expand()` to ensure a step value of `0` is not used.", cvssVector: "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H", reference: "https://guide.sonatype.com/component/npm/brace-expansion/1.1.12?utm_source=node&utm_medium=integration", }, scanId: "6909c9a3-8e23-4230-98d2-92f60f4f9967", },
{ _id: "9d4cc637-d7ae-4a90-9a2b-a0814b7ca385", tool: "sonatype", severity: "high", cvss: 7.5, cve: "CVE-2026-26996", cwe: "CWE-1333", title: "CVE-2026-26996 in minimatch@3.1.2", asset: "Language detection", status: "open", fixVersion: null, firstSeen: DateTime("2026-05-04 11:13:11.159 +00:00:00"), lastSeen: DateTime("2026-05-04 11:13:11.159 +00:00:00"), remediationSteps: [ "No golden version available — review minimatch@3.1.2 manually.", "Check upstream advisories and consider an alternative dependency.", "See advisory: https://guide.sonatype.com/vulnerability/CVE-2026-26996?component-type=npm&component-name=minimatch&utm_source=node&utm_medium=integration", "See advisory: https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/26xxx/CVE-2026-26996.json", "See advisory: https://github.com/isaacs/minimatch/security/advisories/GHSA-3ppc-4f35-3m26", ], references: [ { label: "NVD", url: "https://nvd.nist.gov/vuln/detail/CVE-2026-26996", }, { label: "OSS Index", url: "https://guide.sonatype.com/vulnerability/CVE-2026-26996?component-type=npm&component-name=minimatch&utm_source=node&utm_medium=integration", }, { label: "External Advisory", url: "http://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-26996", }, { label: "Component page", url: "https://guide.sonatype.com/component/npm/minimatch/3.1.2?utm_source=node&utm_medium=integration", }, ], evidence: { coordinates: "pkg:npm/minimatch@3.1.2", ecosystem: "npm", detectionType: "dependency", licenseId: null, licenseRisk: "UNKNOWN", goldenVersion: null, isReachable: null, qualityRisk: null, supplyChainThreat: null, vulnerabilityId: "CVE-2026-26996", description: "minimatch is a minimal matching utility for converting glob expressions into JavaScript RegExp objects. Versions 10.2.0 and below are vulnerable to Regular Expression Denial of Service (ReDoS) when a glob pattern contains many consecutive * wildcards followed by a literal character that doesn't appear in the test string. Each * compiles to a separate [^/]*? regex group, and when the match fails, V8's regex engine backtracks exponentially across all possible splits. The time complexity is O(4^N) where N is the number of * characters. With N=15, a single minimatch() call takes ~2 seconds. With N=34, it hangs effectively forever. Any application that passes user-controlled strings to minimatch() as the pattern argument is vulnerable to DoS. This issue has been fixed in version 10.2.1.", cvssVector: "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H", reference: "https://guide.sonatype.com/component/npm/minimatch/3.1.2?utm_source=node&utm_medium=integration", }, scanId: "6909c9a3-8e23-4230-98d2-92f60f4f9967", },
{ _id: "8fde33fc-f2be-4cb3-acc8-e287612869fa", tool: "sonatype", severity: "high", cvss: 8.7, cve: "CVE-2026-27903", cwe: "CWE-407", title: "CVE-2026-27903 in minimatch@3.1.2", asset: "Language detection", status: "open", fixVersion: "10.2.3", firstSeen: DateTime("2026-05-04 11:13:11.159 +00:00:00"), lastSeen: DateTime("2026-05-04 11:13:11.159 +00:00:00"), remediationSteps: [ "No golden version available — review minimatch@3.1.2 manually.", "Check upstream advisories and consider an alternative dependency.", "See advisory: https://guide.sonatype.com/vulnerability/CVE-2026-27903?component-type=npm&component-name=minimatch&utm_source=node&utm_medium=integration", "Upgrade to version 10.2.3 or later", "See advisory: https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/27xxx/CVE-2026-27903.json", "See advisory: https://github.com/isaacs/minimatch/security/advisories/GHSA-7r86-cg39-jmmj", ], references: [ { label: "NVD", url: "https://nvd.nist.gov/vuln/detail/CVE-2026-27903", }, { label: "OSS Index", url: "https://guide.sonatype.com/vulnerability/CVE-2026-27903?component-type=npm&component-name=minimatch&utm_source=node&utm_medium=integration", }, { label: "External Advisory", url: "http://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-27903", }, { label: "Component page", url: "https://guide.sonatype.com/component/npm/minimatch/3.1.2?utm_source=node&utm_medium=integration", }, ], evidence: { coordinates: "pkg:npm/minimatch@3.1.2", ecosystem: "npm", detectionType: "dependency", licenseId: null, licenseRisk: "UNKNOWN", goldenVersion: null, isReachable: null, qualityRisk: null, supplyChainThreat: null, vulnerabilityId: "CVE-2026-27903", description: "minimatch is a minimal matching utility for converting glob expressions into JavaScript RegExp objects. Prior to version 10.2.3, 9.0.7, 8.0.6, 7.4.8, 6.2.2, 5.1.8, 4.2.5, and 3.1.3, `matchOne()` performs unbounded recursive backtracking when a glob pattern contains multiple non-adjacent `**` (GLOBSTAR) segments and the input path does not match. The time complexity is O(C(n, k)) -- binomial -- where `n` is the number of path segments and `k` is the number of globstars. With k=11 and n=30, a call to the default `minimatch()` API stalls for roughly 5 seconds. With k=13, it exceeds 15 seconds. No memoization or call budget exists to bound this behavior. Any application where an attacker can influence the glob pattern passed to `minimatch()` is vulnerable. The realistic attack surface includes build tools and task runners that accept user-supplied glob arguments (ESLint, Webpack, Rollup config), multi-tenant systems where one tenant configures glob-based rules that run in a shared process, admin or developer interfaces that accept ignore-rule or filter configuration as globs, and CI/CD pipelines that evaluate user-submitted config files containing glob patterns. An attacker who can place a crafted pattern into any of these paths can stall the Node.js event loop for tens of seconds per invocation. The pattern is 56 bytes for a 5-second stall and does not require authentication in contexts where pattern input is part of the feature. Versions 10.2.3, 9.0.7, 8.0.6, 7.4.8, 6.2.2, 5.1.8, 4.2.5, and 3.1.3 fix the issue.", cvssVector: "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N", reference: "https://guide.sonatype.com/component/npm/minimatch/3.1.2?utm_source=node&utm_medium=integration", }, scanId: "6909c9a3-8e23-4230-98d2-92f60f4f9967", },
{ _id: "405bcdc7-7f24-4e9d-9978-353b1ce44a9e", tool: "sonatype", severity: "high", cvss: 7.5, cve: "CVE-2026-27904", cwe: "CWE-1333", title: "CVE-2026-27904 in minimatch@3.1.2", asset: "Language detection", status: "open", fixVersion: "10.2.3", firstSeen: DateTime("2026-05-04 11:13:11.159 +00:00:00"), lastSeen: DateTime("2026-05-04 11:13:11.159 +00:00:00"), remediationSteps: [ "No golden version available — review minimatch@3.1.2 manually.", "Check upstream advisories and consider an alternative dependency.", "See advisory: https://guide.sonatype.com/vulnerability/CVE-2026-27904?component-type=npm&component-name=minimatch&utm_source=node&utm_medium=integration", "Upgrade to version 10.2.3 or later", "See advisory: https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/27xxx/CVE-2026-27904.json", "See advisory: https://github.com/isaacs/minimatch/security/advisories/GHSA-23c5-xmqv-rm74", ], references: [ { label: "NVD", url: "https://nvd.nist.gov/vuln/detail/CVE-2026-27904", }, { label: "OSS Index", url: "https://guide.sonatype.com/vulnerability/CVE-2026-27904?component-type=npm&component-name=minimatch&utm_source=node&utm_medium=integration", }, { label: "External Advisory", url: "http://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-27904", }, { label: "Component page", url: "https://guide.sonatype.com/component/npm/minimatch/3.1.2?utm_source=node&utm_medium=integration", }, ], evidence: { coordinates: "pkg:npm/minimatch@3.1.2", ecosystem: "npm", detectionType: "dependency", licenseId: null, licenseRisk: "UNKNOWN", goldenVersion: null, isReachable: null, qualityRisk: null, supplyChainThreat: null, vulnerabilityId: "CVE-2026-27904", description: "minimatch is a minimal matching utility for converting glob expressions into JavaScript RegExp objects. Prior to version 10.2.3, 9.0.7, 8.0.6, 7.4.8, 6.2.2, 5.1.8, 4.2.5, and 3.1.4, nested `*()` extglobs produce regexps with nested unbounded quantifiers (e.g. `(?:(?:a|b)*)*`), which exhibit catastrophic backtracking in V8. With a 12-byte pattern `*(*(*(a|b)))` and an 18-byte non-matching input, `minimatch()` stalls for over 7 seconds. Adding a single nesting level or a few input characters pushes this to minutes. This is the most severe finding: it is triggered by the default `minimatch()` API with no special options, and the minimum viable pattern is only 12 bytes. The same issue affects `+()` extglobs equally. Versions 10.2.3, 9.0.7, 8.0.6, 7.4.8, 6.2.2, 5.1.8, 4.2.5, and 3.1.4 fix the issue.", cvssVector: "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H", reference: "https://guide.sonatype.com/component/npm/minimatch/3.1.2?utm_source=node&utm_medium=integration", }, scanId: "6909c9a3-8e23-4230-98d2-92f60f4f9967", },
{ _id: "0956b832-ad35-4d43-9edf-c213d3324e63", tool: "sonatype", severity: "high", cvss: 8.7, cve: "CVE-2025-69873", cwe: "CWE-1333", title: "CVE-2025-69873 in ajv@6.12.6", asset: "Language detection", status: "open", fixVersion: "8.18.0", firstSeen: DateTime("2026-05-04 11:13:11.16 +00:00:00"), lastSeen: DateTime("2026-05-04 11:13:11.16 +00:00:00"), remediationSteps: [ "No golden version available — review ajv@6.12.6 manually.", "Check upstream advisories and consider an alternative dependency.", "See advisory: https://guide.sonatype.com/vulnerability/CVE-2025-69873?component-type=npm&component-name=ajv&utm_source=node&utm_medium=integration", "Upgrade to version 8.18.0 or later", "See advisory: https://github.com/advisories/GHSA-2g4f-4pwh-qvx6", "See advisory: https://github.com/ajv-validator/ajv/pull/2588", ], references: [ { label: "NVD", url: "https://nvd.nist.gov/vuln/detail/CVE-2025-69873", }, { label: "OSS Index", url: "https://guide.sonatype.com/vulnerability/CVE-2025-69873?component-type=npm&component-name=ajv&utm_source=node&utm_medium=integration", }, { label: "External Advisory", url: "http://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2025-69873", }, { label: "Component page", url: "https://guide.sonatype.com/component/npm/ajv/6.12.6?utm_source=node&utm_medium=integration", }, ], evidence: { coordinates: "pkg:npm/ajv@6.12.6", ecosystem: "npm", detectionType: "dependency", licenseId: null, licenseRisk: "UNKNOWN", goldenVersion: null, isReachable: null, qualityRisk: null, supplyChainThreat: null, vulnerabilityId: "CVE-2025-69873", description: "ajv (Another JSON Schema Validator) before 8.18.0 is vulnerable to Regular Expression Denial of Service (ReDoS) when the $data option is enabled. The pattern keyword accepts runtime data via JSON Pointer syntax ($data reference), which is passed directly to the JavaScript RegExp() constructor without validation. An attacker can inject a malicious regex pattern (e.g., "^(a|a)*$") combined with crafted input to cause catastrophic backtracking. A 31-character payload causes approximately 44 seconds of CPU blocking, with each additional character doubling execution time. This enables complete denial of service with a single HTTP request against any API using ajv with $data: true for dynamic schema validation. This issue is also fixed in version 6.14.0.

Sonatype's research suggests that this CVE's details differ from those defined at NVD. See https://guide.sonatype.com/vulnerability/CVE-2025-69873 for details", cvssVector: "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N", reference: "https://guide.sonatype.com/component/npm/ajv/6.12.6?utm_source=node&utm_medium=integration", }, scanId: "6909c9a3-8e23-4230-98d2-92f60f4f9967", },
