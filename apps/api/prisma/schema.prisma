generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Scan {
  id          String    @id @map("_id")
  tool        String
  asset       String
  status      String    @default("queued")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  critical    Int?
  high        Int?
  medium      Int?
  passedGate  Boolean?
  findings    Finding[]

  @@index([tool, asset])
  @@index([status])
  @@index([startedAt])
}

model Finding {
  id               String   @id @map("_id")
  tool             String
  severity         String
  cvss             Float?
  cve              String?
  cwe              String?
  title            String
  asset            String
  status           String   @default("open")
  fixVersion       String?
  firstSeen        DateTime
  lastSeen         DateTime
  remediationSteps String[]
  references       Json     @default("[]")
  evidence         Json
  scanId           String

  scan Scan @relation(fields: [scanId], references: [id])

  @@index([cve])
  @@index([asset])
  @@index([severity])
  @@index([tool])
  @@index([status])
  @@index([scanId])
  @@index([firstSeen])
}

model ReportDownload {
  id        String   @id @map("_id")
  name      String
  format    String
  size      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
