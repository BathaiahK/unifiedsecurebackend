{
  "name": "@usp/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup src/index.ts --format esm --no-splitting",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env src/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "mongodb": "^6.5.0",
    "@prisma/client": "^5.15.0",
    "@usp/config": "workspace:*",
    "@usp/schema": "workspace:*",
    "@usp/adapter-blackduck": "workspace:*",
    "@usp/adapter-sonatype": "workspace:*",
    "@usp/adapter-sca": "workspace:*",
    "@usp/adapter-git-history": "workspace:*",
    "@usp/adapter-sast": "workspace:*",
    "@usp/adapter-dast": "workspace:*",
    "@usp/adapter-api-security": "workspace:*",
    "@usp/adapter-container": "workspace:*",
    "@usp/adapter-supply-chain": "workspace:*",
    "@usp/adapter-malware": "workspace:*",
    "@usp/vuln-db": "workspace:*",
    "@usp/remediation": "workspace:*",
    "fastify": "^4.28.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/env": "^4.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.15.0",
    "tsup": "^8.1.0",
    "tsx": "^4.15.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "@types/node": "^20.14.2"
  }
}
